# UNAEP public template — no secrets or tenant-specific identifiers

# Runtime
UNAEP_API_KEY=change-me
UNAEP_CONFIRMATION_SECRET=change-me-long-random-secret
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=gpt-5-mini
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional Azure AI Search / RAG
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=unaep-knowledge
AZURE_SEARCH_KEY=

# Optional Azure Blob persistence
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=unaep-crm

# Langfuse
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Confident AI / DeepEval hosted reports
CONFIDENT_API_KEY=

# Jev / TypeSafe AI
TYPESAFE_API_KEY=

# Evaluation
DEEPEVAL_EVAL_MODE=llm
EVAL_THRESHOLD=0.90
